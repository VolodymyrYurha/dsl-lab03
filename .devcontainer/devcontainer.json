// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.245.2/containers/java
{
	"name": "Scala",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			// Update the VARIANT arg to pick a Java version: 21, 25
			// Append -bookworm or -trixie to pin to an OS version.
			"VARIANT": "25"
		}
	},

	// Configure tool-specific properties.
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			// Set *default* container specific settings.json values on container create.
			"settings": {
				// Override host user settings that point to macOS paths.
				"metals.javaHome": "/usr/lib/jvm/msopenjdk-current",
				"metals.sbtScript": "/usr/local/sdkman/candidates/sbt/current/bin/sbt"
			},
			
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"vscjava.vscode-java-pack",
				"scalameta.metals"
			]
		}
	},

	// Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
	"remoteUser": "vscode",

	// Keep build and IDE state in container-only volumes. sbt 2 fills target/
	// with symlinks into its cache under the user's home, and Metals, Bloop and
	// sbt's BSP config store absolute paths, so state written on the host is
	// broken inside the container (and vice versa).
	"mounts": [
		"source=${devcontainerId}-target,target=${containerWorkspaceFolder}/target,type=volume",
		"source=${devcontainerId}-project-target,target=${containerWorkspaceFolder}/project/target,type=volume",
		"source=${devcontainerId}-project-project-target,target=${containerWorkspaceFolder}/project/project/target,type=volume",
		"source=${devcontainerId}-metals,target=${containerWorkspaceFolder}/.metals,type=volume",
		"source=${devcontainerId}-bsp,target=${containerWorkspaceFolder}/.bsp,type=volume",
		"source=${devcontainerId}-project-bloop,target=${containerWorkspaceFolder}/project/.bloop,type=volume",
		"source=${devcontainerId}-project-project-bloop,target=${containerWorkspaceFolder}/project/project/.bloop,type=volume"
	],
	// New volumes are owned by root; hand them to the remote user.
	"postCreateCommand": "sudo chown vscode:vscode target project/target project/project/target .metals .bsp project/.bloop project/project/.bloop",

	"features": {
		"ghcr.io/devcontainers/features/git:1": {
			"version": "latest"
		}
	}
}
